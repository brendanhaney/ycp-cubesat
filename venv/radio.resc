$global.radio_elf ?= @build/renode/radio.elf
mach create "radio"
machine LoadPlatformDescription @platforms/cpus/stm32h7.repl
machine UnregisterFromParent sysbus.spi4
machine LoadPlatformDescriptionFromString "spi4: Bus.ExternalControlBusPeripheral @ sysbus 0x40013400 { size: 0x400 }"
showAnalyzer sysbus.usart1
sysbus LoadELF $global.radio_elf
sysbus.cpu VectorTableOffset 0x08000000
sysbus.cpu SP `sysbus ReadDoubleWord 0x08000000`
sysbus.cpu PC `sysbus ReadDoubleWord 0x08000004`
