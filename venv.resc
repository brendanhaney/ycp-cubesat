# This file is used by Renode to creates a virtual environment

# Create machine
mach create "stm32h7"

# Load the built-in STM32H7 platform description
machine LoadPlatformDescription @platforms/cpus/stm32h7.repl

# Enable a UART analyzer window (USART1 is enabled by default in stm32h7.repl)
showAnalyzer sysbus.usart1

# Load your ELF executable
$bin = @build/avionics.elf
sysbus LoadELF $bin

# Start execution
start